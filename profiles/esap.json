{
  "description": "Emil's Super App Planner: a TypeScript front end with three tsconfigs, and a Rust workspace.",
  "env": {
    "CARGO_TARGET_DIR": "{worktree}-target"
  },
  "checks": {
    "typecheck": { "run": ["npm", "run", "typecheck"] },
    "eslint": { "when": [".ts", ".tsx"], "run": ["npx", "eslint", "{allowed}"] },
    "prettier": {
      "when": [".ts", ".tsx", ".md", ".json", ".css"],
      "run": ["npx", "prettier", "--check", "{allowed}"]
    },
    "cargo_check": { "run": ["cargo", "check", "--workspace", "--all-targets"] },
    "clippy": { "run": ["cargo", "clippy", "--workspace", "--all-targets", "--", "-D", "warnings"] },
    "cargo_fmt": { "run": ["cargo", "fmt", "--all", "--check"] }
  },
  "format": [
    { "when": [".ts", ".tsx", ".md", ".json", ".css"], "run": ["npx", "prettier", "--write", "{allowed}"] },
    { "when": [".rs"], "run": ["cargo", "fmt", "--", "{allowed}"] }
  ]
}
